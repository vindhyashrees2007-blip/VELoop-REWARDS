# GEMINI_API_KEY: Required for Gemini AI API calls (gemini-3.1-pro-preview & gemini-3.1-flash-image-preview).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Backend Configuration (VELoop Rewards MERN Stack)
PORT=3000
MONGO_URI="mongodb+srv://username:password@cluster0.mongodb.net/veloop_rewards?retryWrites=true&w=majority"
JWT_SECRET="veloop_super_secret_jwt_signing_key_dev_2026"

# Frontend Configuration
VITE_API_URL="/api"

